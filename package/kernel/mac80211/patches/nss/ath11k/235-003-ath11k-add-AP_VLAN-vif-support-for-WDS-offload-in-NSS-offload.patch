+	if (!ap_vlan_arvif)
+		goto unlock;
+
+	spin_lock_bh(&ab->base_lock);
+	peer = ath11k_peer_find(ab, arvif->vdev_id, sta->addr);
+	if (!peer || peer->sta != sta) {
+		spin_unlock_bh(&ab->base_lock);
+		ret = -ENOENT;
+		goto rollback;
+	}
+	wds_peer_id = peer->peer_id;
+	ether_addr_copy(wds_addr, peer->addr);
+	spin_unlock_bh(&ab->base_lock);
+
+	if (!ap_vlan_arvif->nss.wds_cfg_done) {
+		ret = ath11k_nss_ext_vdev_configure(ap_vlan_arvif);
+		if (ret)
+			goto rollback;
+	}
+
