+	 * Keep them available for retry and for normal remove_interface cleanup.
+	 */
+	WRITE_ONCE(arsta->use_4addr_set, false);
+	ath11k_warn(ab, "failed to configure 4addr for STA %pM: %d\n",
+		    sta->addr, ret);
+unlock:
+	mutex_unlock(&ar->conf_mutex);
 }
 
