 	if (ret)
-		ath11k_warn(ar->ab, "failed to set peer %pM 4addr capability: %d\n",
-			    sta->addr, ret);
+		goto rollback;
+
+	ret = ath11k_nss_ext_vdev_wds_4addr_allow(ap_vlan_arvif,
+						wds_peer_id, true);
+	if (ret)
+		goto rollback;
+	nss_4addr = true;
+
+	/* An open timeout can still mean NSS accepted the request. */
+	close_ext = !ap_vlan_arvif->nss.ext_vdev_up;
+	ret = ath11k_nss_ext_vdev_up(ap_vlan_arvif);
+	if (ret)
+		goto rollback;
+
+	ret = ath11k_wmi_vdev_set_param_cmd(ar, arvif->vdev_id,
+					    WMI_VDEV_PARAM_AP_ENABLE_NAWDS,
+					    MIN_IDLE_INACTIVE_TIME_SECS);
+	if (ret)
+		goto rollback;
+
+	/* A firmware unmap can remove the peer during the synchronous calls. */
+	spin_lock_bh(&ab->base_lock);
+	peer = ath11k_peer_find(ab, arvif->vdev_id, wds_addr);
+	if (!peer || peer->peer_id != wds_peer_id || peer->sta != sta) {
+		spin_unlock_bh(&ab->base_lock);
+		ret = -ENOENT;
+		goto rollback;
+	}
+	peer->nss.ext_vdev_up = true;
+	peer->nss.ext_vif = ap_vlan_arvif->vif;
+	spin_unlock_bh(&ab->base_lock);
+	ap_vlan_arvif->nss.wds_cfg_done = true;
+	goto unlock;
+
+rollback:
+	if (close_ext) {
+		rollback_ret = ath11k_nss_ext_vdev_down(ap_vlan_arvif);
+		if (rollback_ret)
+			ath11k_warn(ab, "failed to close ext vdev during 4addr rollback: %d\n",
+				    rollback_ret);
+	}
+	if (nss_4addr) {
+		rollback_ret = ath11k_nss_ext_vdev_wds_4addr_allow(ap_vlan_arvif,
+								wds_peer_id, false);
+		if (rollback_ret)
+			ath11k_warn(ab, "failed to disable NSS 4addr during rollback: %d\n",
+				    rollback_ret);
+	}
+	rollback_ret = ath11k_wmi_set_peer_param(ar, sta->addr, arvif->vdev_id,
+						 WMI_PEER_USE_4ADDR, 0);
+	if (rollback_ret)
+		ath11k_warn(ab, "failed to clear firmware 4addr during rollback: %d\n",
+			    rollback_ret);
+failed:
