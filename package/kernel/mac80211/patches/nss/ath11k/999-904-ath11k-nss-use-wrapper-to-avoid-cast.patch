Subject: [PATCH] ath11k nss use wrapper to avoid cast

Retain typed data/event callback wrappers for SDK registration. Mesh
capability now uses the request-cookie helper directly, so the old
callback-cast and shared-completion edits for that function are removed
rather than reintroducing stale waiter state.
---
 drivers/net/wireless/ath/ath11k/nss.c |   61 ++++++++++++++++++++++++-----------------
 1 file changed, 36 insertions(+), 25 deletions(-)

--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -516,13 +516,14 @@ static void ath11k_nss_peer_msg_complete
 
 /*-----------------------------Events/Callbacks------------------------------*/
 
-void ath11k_nss_wifili_event_receive(struct ath11k_base *ab, struct nss_wifili_msg *msg)
+void ath11k_nss_wifili_event_receive(void *context, struct nss_wifili_msg *msg)
 {
 	u32 msg_type = msg->cm.type;
 	enum nss_cmn_response response = msg->cm.response;
 	u32 error =  msg->cm.error;
 	u32 peer_id;
 	struct nss_wifili_peer_stats *peer_stats;
+	struct ath11k_base *ab = (struct ath11k_base *)context;
 
 	if (!ab)
 		return;
@@ -709,6 +710,16 @@ ath11k_nss_wifili_ext_callback_fn(struct
 	}
 }
 
+static inline void ath11k_nss_wifili_ext_callback_wrapper(struct net_device *netdev,
+						   struct sk_buff *skb,
+						   struct napi_struct *napi)
+{
+	/* nss_register_wifili_if() stores ab as its opaque netdev context. */
+	struct ath11k_base *ab = (struct ath11k_base *)netdev;
+
+	ath11k_nss_wifili_ext_callback_fn(ab, skb, napi);
+}
+
