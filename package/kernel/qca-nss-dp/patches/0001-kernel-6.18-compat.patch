Subject: [PATCH] nss-dp: follow RFS hashing and platform remove APIs

Use the same hash_32() flow-table index as the networking core starting
with Linux 6.15. Keep the mask lookup on older kernels. Bind the void
remove callback through platform_driver.remove on Linux 6.11 and newer.

--- a/nss_dp_main.c
+++ b/nss_dp_main.c
@@ -18,6 +18,7 @@
 
 #include "nss_dp_dev.h"
 
+#include <linux/hash.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/version.h>
@@ -526,7 +527,11 @@ static int nss_dp_rx_flow_steer(struct n
 	}
 
 	hash = skb_get_hash(skb);
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0))
+	rxflow = &flow_table->flows[hash_32(hash, flow_table->log)];
+#else
 	rxflow = &flow_table->flows[hash & flow_table->mask];
+#endif
 	rxcpu = (uint32_t)rxflow->cpu;
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 9, 0))
@@ -1093,7 +1098,8 @@ MODULE_DEVICE_TABLE(of, nss_dp_dt_ids);
 
 static struct platform_driver nss_dp_drv = {
 	.probe = nss_dp_probe,
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)) && \
+    (LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0))
 	.remove_new = nss_dp_remove,
 #else
 	.remove = nss_dp_remove,
